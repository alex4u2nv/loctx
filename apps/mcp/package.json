{
  "name": "@loctx/mcp",
  "version": "0.1.0",
  "description": "MCP stdio server exposing loctx workspace search to coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "loctx-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git",
    "directory": "apps/mcp"
  },
  "bugs": "https://github.com/alex4u2nv/loctx/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@loctx/core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
