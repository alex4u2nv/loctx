{
  "name": "@loctx/mcp",
  "version": "0.3.0",
  "description": "MCP stdio server exposing loctx workspace search to coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "loctx-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prepublishOnly": "pnpm run build"
  },
  "license": "Apache-2.0",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git",
    "directory": "apps/mcp"
  },
  "bugs": "https://github.com/alex4u2nv/loctx/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stdio",
    "loctx",
    "code-search",
    "ai-agents",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@loctx/core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
