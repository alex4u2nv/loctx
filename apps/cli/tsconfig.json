{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Map.groupBy (CLI-8) is ES2024; runtime floor is Node 22, which ships it.
    "lib": ["ES2024"],
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../web/tsconfig.server.json"
    }
  ]
}
