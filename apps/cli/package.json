{
  "name": "@loctx/cli",
  "version": "0.1.0",
  "description": "Commander CLI for loctx — index, search, and run the integrated daemon.",
  "type": "module",
  "bin": {
    "loctx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm run build"
  },
  "license": "Apache-2.0",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/alex4u2nv/loctx/issues",
  "keywords": [
    "loctx",
    "cli",
    "code-search",
    "mcp",
    "model-context-protocol",
    "embeddings",
    "local-first",
    "indexing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@inquirer/prompts": "^8.4.2",
    "@loctx/core": "workspace:^",
    "@loctx/web": "workspace:*",
    "commander": "^12.1.0"
  }
}
