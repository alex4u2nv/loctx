{
  "name": "@loctx/web",
  "version": "0.1.0",
  "description": "Admin / management UI for loctx (Vite SPA + Hono).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/server/index.d.ts",
      "default": "./dist/server/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@hono/node-server": "^1.13.0",
    "@loctx/core": "workspace:*",
    "@loctx/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "d3-shape": "^3.2.0",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
