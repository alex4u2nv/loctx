{
  "name": "@loctx/web",
  "version": "0.7.0",
  "description": "Admin / management UI for loctx (Vite SPA + Hono).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Mahabir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex4u2nv/loctx.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/server/index.d.ts",
      "default": "./dist/server/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@loctx/core": "workspace:*",
    "@loctx/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "hono": "^4.13.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "shiki": "^1.29.2",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  }
}
