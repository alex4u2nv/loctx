{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./client/*"],
      "@shared/*": ["./shared/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["client/**/*.ts", "client/**/*.tsx", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "server"]
}
