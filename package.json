{
  "name": "loctx-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check packages apps",
    "format": "biome format --write packages apps",
    "format:check": "biome format --check packages apps",
    "verify": "npm run build && npm run lint && npm run typecheck && npm test",
    "dev:cli": "npm run dev --workspace @loctx/cli --",
    "dev:web": "npm run dev --workspace @loctx/web",
    "dev:mcp": "npm run dev --workspace @loctx/mcp"
  },
  "license": "Apache-2.0",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
