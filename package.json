{
  "name": "loctx-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check packages apps",
    "format": "biome format --write packages apps",
    "format:check": "biome format --check packages apps",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm test",
    "install:local": "pnpm run build && npm install -g ./apps/cli ./apps/mcp",
    "prepare": "lefthook install",
    "dev:cli": "pnpm --filter @loctx/cli dev --",
    "dev:web": "pnpm --filter @loctx/web dev",
    "dev:mcp": "pnpm --filter @loctx/mcp dev"
  },
  "license": "Apache-2.0",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.19.21",
    "lefthook": "^2.1.9",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
