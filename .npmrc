# Pin Font Awesome packages to npmjs.org so CI (which has no
# npm.fontawesome.com auth token) can install them. The free FA
# packages mirror to npmjs anyway. Override your shell's
# ~/.npmrc scope mapping for this repo only.
@fortawesome:registry=https://registry.npmjs.org/
@awesome.me:registry=https://registry.npmjs.org/

# pnpm settings (tracked so CI + contributors share resolver behavior).
auto-install-peers=true
strict-peer-dependencies=false
