{
  "name": "@loctx/core",
  "version": "0.1.0",
  "description": "Local-first code indexing and search engine. Library used by the CLI, MCP server, and web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "license": "Apache-2.0",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/alex4u2nv/loctx/issues",
  "keywords": [
    "code-search",
    "embeddings",
    "vector-search",
    "lancedb",
    "tree-sitter",
    "mcp",
    "model-context-protocol",
    "rag",
    "local-first",
    "indexing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@lancedb/lancedb": "^0.27.2",
    "@parcel/watcher": "^2.5.6",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.11.1",
    "env-paths": "^4.0.0",
    "ignore": "^7.0.5",
    "tree-sitter": "0.22.4",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.6",
    "tree-sitter-rust": "0.23.3",
    "tree-sitter-typescript": "0.23.2",
    "undici": "^7.10.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
