{
  "name": "@loctx/core",
  "version": "0.1.0",
  "description": "Local-first code indexing and search engine. Library used by the CLI, MCP server, and web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "Alex Mahabir",
  "homepage": "https://github.com/alex4u2nv/loctx",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alex4u2nv/loctx.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/alex4u2nv/loctx/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@lancedb/lancedb": "^0.27.2",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^4.0.1",
    "env-paths": "^3.0.0",
    "ignore": "^6.0.2",
    "tree-sitter": "^0.22.0",
    "tree-sitter-go": "^0.23.0",
    "tree-sitter-java": "^0.23.0",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-python": "^0.23.0",
    "tree-sitter-rust": "^0.23.0",
    "tree-sitter-typescript": "^0.23.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11"
  }
}
