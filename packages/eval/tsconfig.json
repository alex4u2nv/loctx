{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Map.groupBy (CLI-12) is ES2024; runtime floor is Node 22, which ships it.
    "lib": ["ES2024"],
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}
